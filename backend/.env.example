# SafeGuard AI Production Configuration
APP_NAME=SafeGuard AI
JWT_SECRET=replace-with-256-bit-random-secret
JWT_EXPIRE_MINUTES=1440
OTP_TTL_SECONDS=300
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (pgvector/pgvector:pg16)
DATABASE_URL=postgresql+asyncpg://safeguard:safeguard_secret@localhost:5432/safeguard_ai

# Redis (OTP TTL = 300s)
REDIS_URL=redis://localhost:6379/0

# Real Email OTP via SMTP (aiosmtplib)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@safeguard.ai

# Real SMS / WhatsApp Alerts via Twilio
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# Optional Police / PCR CAD Webhook & Public Tracking URL
DISPATCH_WEBHOOK_URL=
PUBLIC_TRACKING_BASE_URL=http://localhost:5173

# MinIO / S3 Object Storage (private bucket: safeguard-evidence)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=safeguard-evidence
S3_REGION=us-east-1

# Google Gemini API (Guardian Agent + text-embedding-004 + Legal RAG)
GEMINI_API_KEY=

# Geospatial APIs (OSRM, Overpass, Nominatim)
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Seeded Command Center Admin Credentials (used by seed_admin.py)
DEFAULT_ADMIN_EMAIL=admin@command.local
DEFAULT_ADMIN_PASSWORD=Admin@SafeGuard2026
